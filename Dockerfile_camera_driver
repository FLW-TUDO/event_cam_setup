# Supports linux/amd64 and linux/arm64 (Jetson).
# Build with build_camera_driver.sh — do not invoke docker build directly.
#
# Base image differs per arch:
#   amd64 → osrf/ros:noetic-desktop-full  (pre-installed rviz/rqt, amd64-only)
#   arm64 → ros:noetic                    (multi-arch; we install extras via apt)
ARG TARGETARCH=amd64
ARG BASE_IMAGE=osrf/ros:noetic-desktop-full
FROM ${BASE_IMAGE}
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

# ── System & ROS build tools ───────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    software-properties-common gnupg wget curl git nano \
    python3-catkin-tools python3-osrf-pycommon \
    python3-pip \
    ros-noetic-camera-info-manager \
    ros-noetic-cv-bridge \
    ros-noetic-image-view \
    ros-noetic-image-transport \
    ros-noetic-image-transport-plugins \
    ros-noetic-vrpn-client-ros \
    netbase \
    libusb-1.0-0 libatomic1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# ── libcaer (iniVation PPA — required by dvxplorer_ros_driver) ────────────
# The base image is Ubuntu 20.04 (focal) for both amd64 and arm64;
# the PPA has packages for both architectures.
RUN apt-get update && apt-get install -y gnupg2 ca-certificates \
    && apt-key adv --keyserver keyserver.ubuntu.com --recv-keys 1D3782C07F873130548A7E822F2CC7DEE2CE4E6A \
    && echo "deb http://ppa.launchpad.net/inivation-ppa/inivation/ubuntu focal main" \
       > /etc/apt/sources.list.d/inivation.list \
    && apt-get update \
    && apt-get install -y libcaer-dev \
    && rm -rf /var/lib/apt/lists/*

# ── IDS / uEye stack for USB3 RGB camera ──────────────────────────────────
RUN apt-get update && apt-get install -y \
    libqt5core5a libqt5gui5 libqt5widgets5 libqt5multimedia5 libqt5quick5 \
    qml-module-qtquick-window2 qml-module-qtquick2 \
    qml-module-qtquick-dialogs qml-module-qtquick-controls \
    qml-module-qtquick-layouts \
    qml-module-qt-labs-settings qml-module-qt-labs-folderlistmodel \
    libcap2 libudev1 libomp5 usbutils \
    && rm -rf /var/lib/apt/lists/*

# Arch-specific IDS / uEye packages.
# build_camera_driver.sh ensures the right files are present and normalises the
# ids-peak filename to ids-peak-<arch>.deb before invoking docker build.
COPY docker_context/ueye-api_4.96.1.2054_${TARGETARCH}.deb       /tmp/ueye-api.deb
COPY docker_context/ueye-common_4.96.1.2054_${TARGETARCH}.deb    /tmp/ueye-common.deb
COPY docker_context/ueye-driver-usb_4.96.1.2054_${TARGETARCH}.deb /tmp/ueye-driver-usb.deb
COPY docker_context/ueye-driver-eth_4.96.1.2054_${TARGETARCH}.deb /tmp/ueye-driver-eth.deb
COPY docker_context/ueye-drivers_4.96.1.2054_${TARGETARCH}.deb   /tmp/ueye-drivers.deb
COPY docker_context/ids-peak-${TARGETARCH}.deb                    /tmp/ids-peak.deb

# Install uEye packages — stub systemctl first to suppress daemon-reload errors
RUN ln -sf /bin/true /usr/bin/systemctl \
    && dpkg -i /tmp/ueye-api.deb \
    && dpkg -i /tmp/ueye-common.deb \
    && dpkg -i /tmp/ueye-driver-usb.deb \
    && dpkg -i /tmp/ueye-driver-eth.deb \
    && dpkg -i /tmp/ueye-drivers.deb \
    && rm /usr/bin/systemctl \
    && ldconfig

# Install IDS Peak with uEye transport layer.
# --force-depends: all real dependencies (ueye-*, Qt, libusb) are installed
# earlier in this Dockerfile; dpkg just can't verify them at install time,
# causing apt-get -f to remove the package instead of keeping it.
RUN mkdir -p /etc/udev/rules.d /etc/environment.d \
    && touch /etc/environment.d/99ids-peak.conf \
    && dpkg -i --force-depends /tmp/ids-peak.deb \
    && rm -f /tmp/ids-peak.deb

# Install IDS Peak Python bindings
RUN PYVER=$(python3 -c "import sys; print('cp%d%d' % sys.version_info[:2])") \
    && WHEEL_DIR="/usr/local/share/ids/bindings/python/wheel" \
    && ls -l ${WHEEL_DIR} \
    && pip3 install $(ls ${WHEEL_DIR}/ids_peak-*-${PYVER}-*.whl | head -n 1) \
    && pip3 install $(ls ${WHEEL_DIR}/ids_peak_ipl-*-${PYVER}-*.whl | head -n 1) \
    && pip3 install $(ls ${WHEEL_DIR}/ids_peak_afl-*-${PYVER}-*.whl | head -n 1)

ENV GENICAM_GENTL64_PATH=/usr/lib/ids/cti

# ── Catkin workspace ──────────────────────────────────────────────────────
ENV WORKSPACE=/catkin_ws
RUN mkdir -p $WORKSPACE/src

# Clone: catkin_simple + rpg_dvs_ros (dvxplorer_ros_driver, dvs_msgs, dvs_renderer)
RUN cd $WORKSPACE/src \
    && git clone https://github.com/catkin/catkin_simple.git \
    && git clone https://github.com/uzh-rpg/rpg_dvs_ros.git

# IDS RGB camera ROS driver (local package — not on PyPI or GitHub)
COPY docker_context/ids_camera_driver/ $WORKSPACE/src/ids_camera_driver/

# Build workspace
RUN /bin/bash -c "source /opt/ros/noetic/setup.bash \
    && cd $WORKSPACE \
    && catkin_make -DCMAKE_BUILD_TYPE=Release"

# ── Python calibration & annotation tools ────────────────────────────────
RUN pip3 install \
    scipy \
    tqdm \
    trimesh \
    aprilgrid

# ── Entrypoint ────────────────────────────────────────────────────────────
COPY docker_context/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
